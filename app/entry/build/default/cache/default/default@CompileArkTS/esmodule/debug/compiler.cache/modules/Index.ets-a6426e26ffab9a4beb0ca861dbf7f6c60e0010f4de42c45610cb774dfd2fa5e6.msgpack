              label: 'ç¯å¢ƒå…‰ç…§',
              valueStr: this.viewModel.telemetry.lux.toFixed(0),
              unit: 'lx',
              channel: 'I2C0@0x23',
              isAlarm: this.viewModel.telemetry.lux < Constants.THRESHOLD_LUX_MIN,
              icon: 'â˜€ï¸'
            })

